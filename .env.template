# -----------------------------------------------------------------------------
# Template for the AMR Surveys extraction script (src/scripts/extract-forms.ts).
#
#   cp .env.template .env.local     &&     edit .env.local
#
# These are the SAME variable names the glass-dev scripts use, so one .env.local
# can drive both repos.
#
# .env.local is NOT loaded automatically. Run the script with:
#   set DOTENV_CONFIG_PATH=.env.local        (Windows cmd)
#   $env:DOTENV_CONFIG_PATH=".env.local"     (PowerShell)
#   DOTENV_CONFIG_PATH=.env.local            (bash, inline)
#
# Never commit the filled-in copy. `.env.local` is git-ignored.
# The extraction script is READ-ONLY: it issues GET requests only.
# -----------------------------------------------------------------------------

# Base URL of the DHIS2 instance. No trailing slash, no embedded credentials.
# Example: https://extranet.who.int/dhis2-demo-indiv
REACT_APP_DHIS2_BASE_URL=

# --- Authentication: EITHER a Personal Access Token (preferred) --------------
# A PAT bypasses 2FA. Generate at: DHIS2 Profile -> Personal Access Tokens.
# The first one set wins, in this order:
#   TOKEN_PROD > TOKEN_PREPROD > TOKEN_TRAINING > TOKEN
#REACT_APP_DHIS2_TOKEN_PROD=
#REACT_APP_DHIS2_TOKEN_PREPROD=
#REACT_APP_DHIS2_TOKEN_TRAINING=
#REACT_APP_DHIS2_TOKEN=

# --- OR basic auth (used only if no token above is set) ----------------------
# Format: username:password. Prefer a dedicated read-only account.
#REACT_APP_DHIS2_AUTH=
